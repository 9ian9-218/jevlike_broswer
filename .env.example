# ============================================================
# 场景 5：双轨浏览器自动化 Agent 运行配置
# ============================================================

# 1. 浏览器设置
# 留空则自动探测 Chrome 或 Edge
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
REMOTE_DEBUG_PORT=9222
HEADLESS=false
HIGHLIGHT_ELEMENT=true
HIGHLIGHT_DURATION=0.3

# 2. 快轨决策设置 (auto | jev | laya | heuristic)
# auto: 优先尝试 Jev (若有KEY) -> Laya (若有本地服务) -> 内置启发式规则
FAST_PATH_MODE=auto

# 云端 Jev 决策端点 (可选)
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1

# 本地 Laya 决策端点 (可选，默认 laya-serve 本地端口)
LAYA_BASE_URL=http://127.0.0.1:8000/v1

# 3. 慢轨生成设置 (Codex / 通用大模型，负责复杂文本输入与自愈)
# 可配置 OpenAI / DeepSeek / 任何兼容 API
SLOW_PATH_API_KEY=
SLOW_PATH_BASE_URL=https://api.openai.com/v1
SLOW_PATH_MODEL=gpt-4o-mini

# 4. 状态机超参数
MAX_STEPS=60
ACTION_TIMEOUT=15.0
STEP_DELAY=0.5
